# Server-side provider credentials. Never expose these in client JavaScript.
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# Optional Hugging Face provider selection. Use "auto" or a provider such as "fal-ai" or "replicate".
HF_INFERENCE_PROVIDER=auto

# Local server port.
PORT=5180

# Local development persistence. Replace with managed database/object storage for production.
DATA_DIR=.data
STARTER_MONTHLY_GENERATION_LIMIT=25
PRO_MONTHLY_GENERATION_LIMIT=500

# Billing. Keep BILLING_PROVIDER=local for development; set to stripe in production once
# Stripe keys, webhook endpoint, price, and public app URL are configured.
BILLING_PROVIDER=local
STRIPE_REQUIRED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
APP_BASE_URL=http://localhost:5180
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:5180

# Asset storage. Use local for development; use s3 for production object storage.
# S3 mode works with S3-compatible providers such as AWS S3, Cloudflare R2, and MinIO.
ASSET_STORAGE_DRIVER=local
ASSET_STORAGE_PREFIX=assets
ASSET_STORAGE_BUCKET=
ASSET_STORAGE_REGION=auto
ASSET_STORAGE_ENDPOINT=
ASSET_STORAGE_FORCE_PATH_STYLE=0
ASSET_STORAGE_ACCESS_KEY_ID=
ASSET_STORAGE_SECRET_ACCESS_KEY=

# Session/auth hardening.
# Required in production. Use a long random value and rotate by forcing users to sign in again.
SESSION_SECRET=
EMAIL_VERIFICATION_REQUIRED=0
# Test/local-only: returns plaintext verification/reset tokens in API responses. Blocked in production.
AUTH_TOKEN_DEBUG=0
# Production guard. Keep this at 0 for public SaaS; set to 1 only for controlled staging
# while real email verification delivery is still being wired.
ALLOW_UNVERIFIED_EMAILS=0
# Transactional email. Use log for local development; use resend for public SaaS.
EMAIL_DELIVERY_DRIVER=log
EMAIL_PRODUCT_NAME=Nano Banana Art Lab
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=
# Production guard. Keep this at 0 for public SaaS; set to 1 only for controlled staging
# where EMAIL_DELIVERY_DRIVER=log is acceptable.
ALLOW_LOCAL_EMAIL_DELIVERY=0

# Safety controls.
CONTENT_POLICY_MODE=local
API_RATE_LIMIT_PER_MINUTE=180
AUTH_RATE_LIMIT_PER_15_MINUTES=25
GENERATION_RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_KEY_PREFIX=nano-banana
REDIS_URL=
# Production guard. Keep this at 0 for public SaaS; set to 1 only for controlled single-instance staging.
ALLOW_IN_MEMORY_RATE_LIMITS=0

# Admin/observability controls.
# Set a strong token to enable read-only /api/admin/* endpoints.
ADMIN_API_TOKEN=
LOG_LEVEL=info

# Deployment readiness. Comma-separated providers that must be configured for /api/readiness to return 200.
REQUIRED_PROVIDERS=

# Production guard. Keep this at 0 for public SaaS; set to 1 only for controlled single-instance staging
# while database/object-storage replacement work is still in progress.
ALLOW_LOCAL_PRODUCTION_STORAGE=0

# Test-only provider mocks. Keep disabled outside automated/local smoke tests.
MOCK_PROVIDER_RESPONSES=0
MOCK_PROVIDER_DELAY_MS=0

# Real-provider smoke tests. These can spend provider credits.
# Run only with explicit approval: RUN_REAL_PROVIDER_SMOKE=1 npm run test:providers
RUN_REAL_PROVIDER_SMOKE=0
REAL_PROVIDER_SMOKE_PROVIDERS=
REAL_PROVIDER_SMOKE_PROMPT=A simple studio product photo of a yellow banana on a white background.
REAL_PROVIDER_SMOKE_KEEP_DATA=0

# Object-storage smoke test. This writes and reads small test images in the configured bucket.
# Run only with explicit approval: RUN_OBJECT_STORAGE_SMOKE=1 ASSET_STORAGE_DRIVER=s3 npm run test:storage
RUN_OBJECT_STORAGE_SMOKE=0
OBJECT_STORAGE_SMOKE_KEEP_DATA=0

# Redis rate-limit smoke test. This writes short-lived counters to the configured Redis instance.
# Run only with explicit approval: RUN_REDIS_RATE_LIMIT_SMOKE=1 REDIS_URL=... npm run test:rate-limit
RUN_REDIS_RATE_LIMIT_SMOKE=0
REDIS_RATE_LIMIT_SMOKE_KEEP_DATA=0

# Test-only Stripe mocks. Keep disabled outside automated/local billing smoke tests.
MOCK_STRIPE_RESPONSES=0
