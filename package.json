{
  "name": "nano-banana-art-lab",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Nano Banana Art Studio: an AI art studio with curated styles, a layered text editor, and credit-based billing.",
  "scripts": {
    "dev": "node server.js --dev",
    "vite:dev": "vite --port 5180",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:providers": "node scripts/real-provider-smoke.mjs",
    "test:storage": "node scripts/object-storage-smoke.mjs",
    "test:rate-limit": "node scripts/redis-rate-limit-smoke.mjs",
    "styles:previews": "node scripts/generate-style-previews.mjs",
    "start": "node server.js --production",
    "preview": "node server.js --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@huggingface/inference": "^4.13.18",
    "redis": "^6.0.0",
    "resend": "^6.12.4",
    "stripe": "^22.2.0"
  }
}
